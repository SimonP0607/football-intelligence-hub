# Where the data on screen comes from. See src/lib/api/mode.ts.
#   mock    every page renders the demo adapter (src/mock)
#   live    every page reads the FastAPI service; a page the backend cannot
#           serve yet says so instead of falling back to demo data
#   hybrid  live where the backend serves it, demo elsewhere; mixed pages
#           are labelled HYBRID in the topbar
VITE_DATA_MODE=live

# The FastAPI product API (football-intelligence-v2). Public: it holds no secret.
# The API-Football key never reaches the browser - the API does not even hold it.
VITE_API_BASE_URL=http://localhost:8010
